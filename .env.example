# Example (non-secret) env file for local setup
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
JWT_SECRET=changeme
PORT=5000
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-app-password
EMAIL_FROM="Purchase Tracker" <your-email@example.com>
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://wici-procurement.org,https://www.wici-procurement.org

# Server-side AI provider configuration. Ollama is local and is the default.
AI_PROVIDER=ollama
AI_TIMEOUT_MS=60000
AI_MAX_TOOL_ITERATIONS=6
AI_MAX_TOOL_RESULT_BYTES=65536
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Optional alternative provider. Not required when AI_PROVIDER=ollama.
OPENAI_API_KEY=
OPENAI_MODEL=

# Supabase shared attachment storage (recommended for multi-server / multi-device access)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=attachments
SUPABASE_STORAGE_PREFIX=attachments

# Set to false in production to avoid silently storing files on local disk when Supabase upload fails.
ATTACHMENT_LOCAL_FALLBACK_ENABLED=false