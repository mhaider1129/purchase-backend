  "extra_functions": [
    {
      "name": "approve_stock_item_request",
      "arguments": "",
      "definition": "CREATE OR REPLACE FUNCTION public.approve_stock_item_request()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\nBEGIN\r\n  IF NEW.status = 'Approved' AND OLD.status IS DISTINCT FROM 'Approved' THEN\r\n    UPDATE public.stock_items\r\n    SET quantity = COALESCE(quantity, 0) + COALESCE(NEW.quantity, 0)\r\n    WHERE id = NEW.stock_item_id;\r\n  END IF;\r\n  RETURN NEW;\r\nEND;\r\n$function$\n"
    },
    {
      "name": "set_user_registration_requests_updated_at",
      "arguments": "",
      "definition": "CREATE OR REPLACE FUNCTION public.set_user_registration_requests_updated_at()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\nBEGIN\r\n  NEW.updated_at := NOW();\r\n  RETURN NEW;\r\nEND;\r\n$function$\n"
    }
