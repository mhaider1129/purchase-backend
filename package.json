{
  "name": "purchase-tracker",
  "version": "1.0.0",
  "description": "A backend system for tracking purchase requisitions, approvals, and procurement workflows.",
  "main": "app.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest",
    "test:p2p-postgres": "node scripts/runP2PPostgresIntegration.js",
    "test:backend-contract-refresh": "node scripts/testBackendContractRefresh.js",
    "migrate": "node scripts/databaseRelease.js plan",
    "migrate:down": "node scripts/databaseRelease.js rollback-disabled",
    "migrate:create": "node scripts/databaseRelease.js new",
    "validate:sql004": "node scripts/validateManualSql.js",
    "test:sql018": "node scripts/testSql018Integration.js",
    "priority:recalculate-aging": "node jobs/recalculateProcurementPriorityAging.js",
    "test:sql028-029": "node scripts/testSql028029Integration.js",
    "verify:p2p-schema": "node scripts/verifyP2PSchemaContract.js",
    "audit:p2p-baseline": "node scripts/auditP2PBaseline.js",
    "test:completion-reporting-postgres": "node scripts/testBackendContractRefresh.js --completion-reporting",
    "test:receipt-acceptance-postgres": "node scripts/testBackendContractRefresh.js --receipt-acceptance",
    "test:completion-postgres": "node scripts/testBackendContractRefresh.js --completion",
    "test:contract-reconciliation-postgres": "node scripts/testBackendContractRefresh.js --contract-reconciliation",
    "test:contract-finance-postgres": "node scripts/testBackendContractRefresh.js --contract-finance",
    "test:contracts-postgres": "node scripts/testBackendContractRefresh.js --contracts",
    "test:request-workspace-postgres": "node scripts/testBackendContractRefresh.js --request-workspace",
    "test:device-demos-postgres": "node scripts/testBackendContractRefresh.js --device-demos",
    "test:contract-settlement-postgres": "node scripts/testBackendContractRefresh.js --contract-settlement",
    "audit:financial-writers": "node scripts/auditFinancialWriters.js",
    "db:inventory": "node scripts/databaseRelease.js inventory",
    "db:plan": "node scripts/databaseRelease.js plan",
    "db:verify": "node scripts/databaseRelease.js verify",
    "test:database-governance-postgres": "node scripts/testBackendContractRefresh.js --database-governance",
    "test:rfid-recovery-postgres": "node scripts/testBackendContractRefresh.js --rfid-recovery"
  },
  "keywords": [
    "purchase",
    "procurement",
    "tracker",
    "nodejs",
    "backend"
  ],
  "author": "Mohammed Haider",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "sanitize-filename": "^1.6.3"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "node-mocks-http": "^1.11.0",
    "node-pg-migrate": "^8.0.3",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2"
  }
}
